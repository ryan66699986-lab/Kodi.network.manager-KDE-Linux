<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.program.wifi"
       name="Wi-Fi"
       version="1.0.9"
       provider-name="local">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension point="xbmc.python.pluginsource"
               library="default.py">
        <provides>executable</provides>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Manage Wi-Fi connections</summary>
        <description lang="en_GB">Scan and connect to Wi-Fi networks from inside Kodi using NetworkManager.</description>
        <platform>linux</platform>
    </extension>
</addon>
